---
const stats = [
  { value: "3+",   label: "Years Building" },
  { value: "100+", label: "Students Mentored" },
  { value: "1K+",  label: "Concurrent Users" },
  { value: "35%",  label: "Onboarding Reduction" },
];

const education = [
  { degree: "M.S. Data Science",        school: "Bellevue University",          years: "2025 – 2027", active: true  },
  { degree: "B.S. Software Development", school: "Bellevue University",          years: "2022 – 2025", active: false },
  { degree: "A.S. Computer Programming", school: "Iowa Western C.C.",            years: "2019 – 2022", active: false },
];

const awards = ["Omega Nu Lambda", "Gottsch Scholarship", "DREAM Scholarship"];
---

<section id="about" class="py-20 border-t border-white/5 relative overflow-hidden">

  <!-- Ambient scan line (CSS only) -->
  <div class="scan-line" aria-hidden="true"></div>

  <!-- Section header -->
  <div class="about-reveal flex flex-col items-center text-center mb-14">
    <div class="flex items-center gap-3 mb-4">
      <span class="h-px w-8 bg-yellow-500/40"></span>
      <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-yellow-500/60">
        01 // SYSTEM_PROFILE
      </span>
      <span class="h-px w-8 bg-yellow-500/40"></span>
    </div>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight uppercase mb-4">ABOUT</h2>
    <div class="h-1 w-12 bg-yellow-500 rounded-full"></div>
  </div>

  <!-- Stats row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14">
    {stats.map((stat, i) => (
      <div class="about-reveal stat-card group flex flex-col items-center justify-center p-6 rounded-2xl border border-white/5 bg-white/[0.03] hover:bg-white/[0.06] hover:border-yellow-500/20 transition-all" style={`--delay: ${i * 80}ms`}>
        <span class="text-3xl md:text-4xl font-bold tracking-tight text-yellow-400 mb-1">{stat.value}</span>
        <span class="font-mono text-[10px] uppercase tracking-widest text-white/40">{stat.label}</span>
      </div>
    ))}
  </div>

  <!-- Two-column: Bio + Education -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

    <!-- Bio card -->
    <div class="about-reveal about-slide-left p-8 rounded-2xl border border-white/5 bg-white/[0.03] flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-yellow-500/10 border border-yellow-500/20">
          <!-- User icon -->
          <svg class="w-5 h-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>
          </svg>
        </div>
        <span class="font-mono text-xs uppercase tracking-widest text-white/50">Profile // Bio</span>
      </div>

      <p class="text-base text-white/70 font-light leading-relaxed">
        I'm a full-stack engineer who builds production systems — the kind that handle real users,
        real data, and real scale. At NE Innovation Labs, I architected a multi-tenant,
        location-based mobile commerce platform from the ground up: Flutter and Serverpod
        on the backend, PostGIS for geospatial queries, Redis for real-time pub/sub, and
        AWS ECS for containerized infrastructure.
      </p>

      <p class="text-base text-white/70 font-light leading-relaxed">
        I spent two years mentoring 100+ students at Bellevue University, which sharpened
        how I communicate complex systems and made me a stronger collaborator. Currently
        pursuing my M.S. in Data Science — bridging engineering with machine learning
        and intelligent, data-driven systems.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/50 font-mono text-[11px] uppercase tracking-wider">
          <!-- MapPin icon -->
          <svg class="w-3 h-3 text-yellow-500/70 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Council Bluffs, IA
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-white/50 font-mono text-[11px] uppercase tracking-wider">
          <!-- Layers icon -->
          <svg class="w-3 h-3 text-yellow-500/70 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
          </svg>
          Open to Remote
        </div>
      </div>
    </div>

    <!-- Education card -->
    <div class="about-reveal about-slide-right p-8 rounded-2xl border border-white/5 bg-white/[0.03] flex flex-col gap-6" style="--delay: 100ms">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-yellow-500/10 border border-yellow-500/20">
          <!-- GraduationCap icon -->
          <svg class="w-5 h-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <span class="font-mono text-xs uppercase tracking-widest text-white/50">Education // Credentials</span>
      </div>

      <!-- Timeline -->
      <div class="flex flex-col gap-5">
        {education.map((item, i) => (
          <div class="flex gap-4 items-start">
            <!-- Dot + spine -->
            <div class="flex flex-col items-center pt-1 shrink-0">
              <div class={`w-2 h-2 rounded-full border ${item.active ? "bg-yellow-400 border-yellow-400 edu-glow" : "bg-white/20 border-white/20"}`}></div>
              {i < education.length - 1 && <div class="w-px h-10 mt-1.5 bg-white/10"></div>}
            </div>
            <!-- Content -->
            <div class="pb-2">
              <div class="flex items-center gap-2 flex-wrap mb-0.5">
                <span class="text-sm font-semibold text-white tracking-tight">{item.degree}</span>
                {item.active && (
                  <span class="px-1.5 py-0.5 rounded bg-yellow-500/10 border border-yellow-500/20 font-mono text-[9px] uppercase tracking-wider text-yellow-400">
                    In Progress
                  </span>
                )}
              </div>
              <div class="font-mono text-[11px] text-white/40 uppercase tracking-wider">{item.school}</div>
              <div class="font-mono text-[11px] text-yellow-500/50 mt-0.5">{item.years}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Awards -->
      <div class="pt-4 border-t border-white/5">
        <p class="font-mono text-[10px] uppercase tracking-widest text-white/30 mb-3">Awards // Recognition</p>
        <div class="flex flex-wrap gap-2">
          {awards.map((award) => (
            <span class="px-2.5 py-1 rounded-lg bg-yellow-500/5 border border-yellow-500/10 font-mono text-[10px] uppercase tracking-wider text-yellow-400/60">
              {award}
            </span>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Scan line animation */
  .scan-line {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    opacity: 0.1;
  }
  .scan-line::after {
    content: '';
    position: absolute;
    height: 1px;
    width: 100%;
    background: linear-gradient(to right, transparent, rgba(234,179,8,0.4), transparent);
    animation: scan 10s linear infinite;
    top: 0;
  }
  @keyframes scan {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%);  }
  }

  /* Scroll reveal — base state */
  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--delay, 0ms);
  }
  .about-slide-left  { transform: translateX(-24px); }
  .about-slide-right { transform: translateX(24px);  }

  /* Visible state (added by JS) */
  .about-reveal.in-view {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* Active education dot glow */
  .edu-glow {
    box-shadow: 0 0 8px rgba(250, 204, 21, 0.6);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
        }
      });
    },
    { threshold: 0.1 }
  );

  document
    .querySelectorAll("#about .about-reveal")
    .forEach((el) => observer.observe(el));
</script>